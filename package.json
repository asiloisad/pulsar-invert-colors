{
  "name": "invert-colors",
  "main": "./lib/main.js",
  "version": "0.4.0",
  "description": "Invert view colors for images, editor, and PDF viewer",
  "keywords": [
    "invert",
    "colors",
    "image",
    "dark-mode"
  ],
  "repository": "https://github.com/asiloisad/pulsar-invert-colors",
  "license": "MIT",
  "engines": {
    "atom": ">=1.0.0 <2.0.0"
  },
  "configSchema": {
    "workspaceState": {
      "title": "Workspace state",
      "description": "Invert Colors of whole workspace",
      "type": "boolean",
      "default": false,
      "order": 1
    },
    "workspaceStatusIcon": {
      "title": "Workspace status icon",
      "description": "Show toggle button in the status bar",
      "type": "boolean",
      "default": false,
      "order": 2
    },
    "editorState": {
      "title": "Editor state",
      "description": "Invert Colors of text editors",
      "type": "boolean",
      "default": false,
      "order": 3
    },
    "editorStatusIcon": {
      "title": "Editor status icon",
      "description": "Show toggle button in the status bar",
      "type": "boolean",
      "default": false,
      "order": 4
    },
    "imageState": {
      "title": "Image state",
      "description": "Invert colors of images",
      "type": "boolean",
      "default": false,
      "order": 5
    },
    "imageStatusIcon": {
      "title": "Image status icon",
      "description": "Show toggle button in the status bar",
      "type": "boolean",
      "default": false,
      "order": 6
    },
    "pdfviewerState": {
      "title": "PDF viewer state",
      "description": "Invert Colors of pdf-viewer instances",
      "type": "boolean",
      "default": false,
      "order": 7
    },
    "pdfviewerStatusIcon": {
      "title": "PDF viewer status icon",
      "description": "Show toggle button in the status bar",
      "type": "boolean",
      "default": false,
      "order": 8
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  }
}
